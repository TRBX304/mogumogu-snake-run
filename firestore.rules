rules_version = '2';

// MOGUMOGU SNAKE RUN — Firestore セキュリティルール
//
// データ構造
//   games/{gameId}                      { uid, startedAt, used }   … ゲーム開始時に発行
//   ranks/{periodKey}/entries/{uid}     { name, score, gameId, updatedAt }
//     periodKey = 'all' | 'm202611'（日本時間の年月）| 'w2970'（月曜始まりの通し週番号）
//
// スコア送信は「games の used を true にする」＋「entries を書く」を1回のバッチで行う。
// ・同じ gameId は一度しか使えない（リプレイ防止）
// ・開始からの経過時間（サーバー時刻）で取りうるスコアの上限を超えたら拒否

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // ---------- 期間キー（js/ranking.js の periodKey と同じ計算） ----------
    function jst() {
      return request.time + duration.value(9, 'h');
    }
    function weekKey() {
      return 'w' + string(math.floor((math.floor(jst().toMillis() / 86400000.0) + 3) / 7.0));
    }
    function monthKey() {
      return 'm' + string(jst().year() * 100 + jst().month());
    }
    function validPeriod(period) {
      return period == 'all' || period == weekKey() || period == monthKey();
    }

    // ---------- ゲーム情報 ----------
    function gameBefore(id) {
      return get(/databases/$(database)/documents/games/$(id)).data;
    }
    function gameAfter(id) {
      return getAfter(/databases/$(database)/documents/games/$(id)).data;
    }
    function elapsedSec(g) {
      return (request.time.toMillis() - g.startedAt.toMillis()) / 1000.0;
    }

    // ---------- スコア上限 ----------
    // 速度は常に min(600, 240 + 6t) px/秒 以下（js/config.js の速度カーブより）。
    // 1000点の金リンゴは最短でも 144px おきなので、点数は 距離/144*1000 を超えない。
    //   t <= 60 : 距離 <= 240t + 3t^2
    //   t >  60 : 距離 <= 25200 + 600(t - 60)
    function withinMaxScore(score, sec) {
      return (sec <= 60 && score <= (240.0 * sec + 3.0 * sec * sec) / 144.0 * 1000.0 + 2000.0)
        || (sec > 60 && score <= (25200.0 + 600.0 * (sec - 60)) / 144.0 * 1000.0 + 2000.0);
    }

    function validName(n) {
      return n is string && n.size() >= 1 && n.size() <= 24;
    }

    // スコアを伴う書き込み（新規作成・自己ベスト更新）
    function validScoreWrite(period, uid) {
      return signedIn()
        && uid == request.auth.uid
        && validPeriod(period)
        && request.resource.data.keys().hasAll(['name', 'score', 'gameId', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['name', 'score', 'gameId', 'updatedAt'])
        && validName(request.resource.data.name)
        && request.resource.data.gameId is string
        && request.resource.data.score is int
        && request.resource.data.score > 0
        && request.resource.data.score % 100 == 0
        && request.resource.data.updatedAt == request.time
        && gameBefore(request.resource.data.gameId).uid == request.auth.uid
        && gameBefore(request.resource.data.gameId).used == false
        && gameAfter(request.resource.data.gameId).used == true
        && elapsedSec(gameBefore(request.resource.data.gameId)) < 10800
        && withinMaxScore(request.resource.data.score, elapsedSec(gameBefore(request.resource.data.gameId)));
    }

    // 表示名だけの変更
    function nameOnlyUpdate(uid) {
      return signedIn()
        && uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name'])
        && validName(request.resource.data.name);
    }

    // ===== 診断用（原因が分かったら丸ごと消す） =====
    match /diag/{test}/runs/{runId} {
      allow create: if signedIn() && (
        (test == 't0')
        || (test == 't1' && request.resource.data.wk == weekKey())
        || (test == 't2' && request.resource.data.mk == monthKey())
        || (test == 't3' && request.resource.data.keys().hasAll(['name', 'score', 'gameId', 'updatedAt'])
              && request.resource.data.keys().hasOnly(['name', 'score', 'gameId', 'updatedAt'])
              && validName(request.resource.data.name)
              && request.resource.data.score is int
              && request.resource.data.score % 100 == 0)
        || (test == 't4' && request.resource.data.updatedAt == request.time)
        || (test == 't5' && gameBefore(request.resource.data.gameId).uid == request.auth.uid)
        || (test == 't6' && gameBefore(request.resource.data.gameId).used == false)
        || (test == 't7' && gameAfter(request.resource.data.gameId).used == true)
        || (test == 't8' && elapsedSec(gameBefore(request.resource.data.gameId)) < 10800)
        || (test == 't9' && withinMaxScore(request.resource.data.score, elapsedSec(gameBefore(request.resource.data.gameId))))
        || (test == 't10' && validScoreWrite('all', request.auth.uid))
      );
    }

    match /games/{gameId} {
      allow create: if signedIn()
        && request.resource.data.keys().hasAll(['uid', 'startedAt', 'used'])
        && request.resource.data.keys().hasOnly(['uid', 'startedAt', 'used'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.startedAt == request.time
        && request.resource.data.used == false;

      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && resource.data.used == false
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['used'])
        && request.resource.data.used == true;

      allow read, delete: if false;
    }

    match /ranks/{period}/entries/{uid} {
      allow read: if true;
      allow create: if validScoreWrite(period, uid);
      allow update: if nameOnlyUpdate(uid)
        || (validScoreWrite(period, uid) && request.resource.data.score > resource.data.score);
      allow delete: if false;
    }
  }
}
